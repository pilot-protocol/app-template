// Per-call environment rules and teardown records for the {{.ID}} cli runner.
// GENERATED by pilot-app; edit pilot.app.yaml and re-generate.
//
// Some CLIs start things that keep running after the CLI itself exits, outside
// the adapter's process group: a detached VM (`smolvm machine start`,
// `machine run -d`), a background daemon the tool manages itself. Neither the
// adapter's clean stop, nor the supervisor's group stop, nor Pdeathsig, nor the
// child guard's group kill reaches them. Found with io.pilot.smol 1.2.0: VMs
// from `machine start` and `machine run -d` survived the app's SIGTERM, the
// supervisor's SIGKILL of the app and uninstall, each holding its VM's memory.
//
// A cli.teardown rule names such a call and the command that undoes it. When a
// matching call runs, the adapter records "run <stop argv> with this env"
// under the resource's name, and hands the record to the child guard
// (childguard.go), which it keeps running while any record is open. Then:
//   - a clean stop (SIGTERM, or the parent-death watch in main) runs every
//     open record itself (RunTeardowns);
//   - if the adapter is SIGKILLed, the guard runs them before it takes the
//     process group down;
//   - a successful explicit stop (a cli.teardown clear_prefixes call for the
//     same name) closes the record, so nothing is stopped twice;
//   - a start call that fails closes the record it opened.
//
// A cli.env_rules rule adds environment to one call's child when its argv
// matches: io.pilot.smol sets SMOLVM_BOOT_BINARY for a foreground
// `machine run`, which arms smolvm's own parent-death watchdog in the VM
// process, so an ephemeral VM dies with its CLI however the CLI is stopped.
package backend

import (
	"context"
	"encoding/json"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"sync"
	"time"
)

// TeardownTimeout bounds one teardown command, from the adapter or the guard.
const TeardownTimeout = 30 * time.Second

// EnvRule is a cli.env_rules entry, baked in at generation time. Env is a flat
// key, value, key, value list; values may use ${command_dir}.
type EnvRule struct {
	Prefix []string
	Unless []string
	Env    []string
}

// TeardownRule is a cli.teardown entry, baked in at generation time.
type TeardownRule struct {
	Prefix      []string
	When        []string
	NameFlags   []string
	DefaultName string
	Run         []string // argv after the base command; ${name}
	Clear       [][]string
}

// teardownRecord is what the guard needs to stop one resource on its own.
type teardownRecord struct {
	Argv []string `json:"argv"` // full argv, base command included
	Env  []string `json:"env"`
}

var (
	tdMu     sync.Mutex
	tdOpen   = map[string]teardownRecord{} // key: rule index + name
	tdClosed bool                          // RunTeardowns has started: no new records
)

// hasPrefix reports whether args starts with prefix, word for word.
func hasPrefix(args, prefix []string) bool {
	if len(prefix) == 0 || len(args) < len(prefix) {
		return false
	}
	for i, p := range prefix {
		if args[i] != p {
			return false
		}
	}
	return true
}

// options returns args up to a "--" (what follows is the guest command, whose
// own flags must not count).
func options(args []string) []string {
	for i, a := range args {
		if a == "--" {
			return args[:i]
		}
	}
	return args
}

// hasAnyFlag reports whether args (before "--") carries one of flags, as
// `-d`, `--detach`, `--detach=...`, or a short flag inside a cluster (`-id`).
func hasAnyFlag(args, flags []string) bool {
	for _, a := range options(args) {
		for _, f := range flags {
			if a == f || strings.HasPrefix(a, f+"=") {
				return true
			}
			if len(f) == 2 && f[0] == '-' && f[1] != '-' && len(a) > 2 && a[0] == '-' && a[1] != '-' && isLetters(a[1:]) && strings.ContainsRune(a[1:], rune(f[1])) {
				return true
			}
		}
	}
	return false
}

func isLetters(s string) bool {
	for _, c := range s {
		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z') {
			return false
		}
	}
	return s != ""
}

// flagValue returns the value of the first of flags in args (before "--"),
// given as `--name x` or `--name=x`, and whether one was found.
func flagValueOf(args, flags []string) (string, bool) {
	opts := options(args)
	for i, a := range opts {
		for _, f := range flags {
			if a == f && i+1 < len(opts) {
				return opts[i+1], true
			}
			if strings.HasPrefix(a, f+"=") {
				return strings.TrimPrefix(a, f+"="), true
			}
		}
	}
	return "", false
}

// ruleEnv returns the extra environment the matching env rules give this call.
func (r *Runner) ruleEnv(rules []EnvRule, args []string) []string {
	var env []string
	for _, er := range rules {
		if !hasPrefix(args, er.Prefix) || hasAnyFlag(args, er.Unless) {
			continue
		}
		for i := 0; i+1 < len(er.Env); i += 2 {
			env = append(env, er.Env[i]+"="+strings.ReplaceAll(er.Env[i+1], "${command_dir}", r.commandDir()))
		}
	}
	return env
}

// commandDir is the directory of the resolved base command.
func (r *Runner) commandDir() string {
	p := r.base[0]
	if !filepath.IsAbs(p) {
		if lp, err := exec.LookPath(p); err == nil {
			p = lp
		}
	}
	if abs, err := filepath.Abs(p); err == nil {
		p = abs
	}
	return filepath.Dir(p)
}

// resourceName resolves the name a teardown rule's call acts on.
func (td TeardownRule) resourceName(args []string) string {
	if v, ok := flagValueOf(args, td.NameFlags); ok && v != "" {
		return v
	}
	return td.DefaultName
}

// tdOpened is one record a call opened, so a failed call can close it again.
type tdOpened struct{ key string }

// openTeardowns records every teardown rule this call matches, before the CLI
// runs (so an adapter killed while the start is in flight still stops what it
// started). It returns the records this call newly opened.
func (r *Runner) openTeardowns(rules []TeardownRule, args, env []string) []tdOpened {
	var opened []tdOpened
	for i, td := range rules {
		if !hasPrefix(args, td.Prefix) || (len(td.When) > 0 && !hasAnyFlag(args, td.When)) {
			continue
		}
		name := td.resourceName(args)
		argv := []string{r.base[0]}
		argv = append(argv, r.base[1:]...)
		for _, a := range td.Run {
			argv = append(argv, strings.ReplaceAll(a, "${name}", name))
		}
		key := teardownKey(i, name)
		rec := teardownRecord{Argv: argv, Env: env}
		tdMu.Lock()
		if tdClosed {
			tdMu.Unlock()
			continue
		}
		_, had := tdOpen[key]
		tdOpen[key] = rec
		tdMu.Unlock()
		line, _ := json.Marshal(rec)
		guard.putRecord(key, line)
		if !had {
			opened = append(opened, tdOpened{key: key})
		}
	}
	return opened
}

// settleTeardowns runs after the call: a start that failed closes the records
// it opened, and a successful explicit stop closes the record it stopped.
func settleTeardowns(rules []TeardownRule, args []string, opened []tdOpened, ok bool) {
	if !ok {
		for _, o := range opened {
			closeTeardown(o.key)
		}
		return
	}
	for i, td := range rules {
		for _, cp := range td.Clear {
			if hasPrefix(args, cp) {
				closeTeardown(teardownKey(i, td.resourceName(args)))
			}
		}
	}
}

func teardownKey(rule int, name string) string {
	b, _ := json.Marshal([]any{rule, name})
	return string(b)
}

func closeTeardown(key string) {
	tdMu.Lock()
	_, had := tdOpen[key]
	delete(tdOpen, key)
	tdMu.Unlock()
	if had {
		guard.dropRecord(key)
	}
}

// RunTeardowns is main's clean-shutdown step: it runs every open record's
// stop command (concurrently, each bounded by timeout) and closes it.
func RunTeardowns(timeout time.Duration) {
	tdMu.Lock()
	tdClosed = true
	recs := tdOpen
	tdOpen = map[string]teardownRecord{}
	tdMu.Unlock()
	if len(recs) == 0 {
		return
	}
	var wg sync.WaitGroup
	for _, rec := range recs {
		wg.Add(1)
		go func(rec teardownRecord) {
			defer wg.Done()
			runTeardown(rec, timeout)
		}(rec)
	}
	wg.Wait()
	for key := range recs {
		guard.dropRecord(key)
	}
}

// runTeardown runs one stop command; its output is discarded.
func runTeardown(rec teardownRecord, timeout time.Duration) {
	if len(rec.Argv) == 0 {
		return
	}
	ctx, cancel := context.WithTimeout(context.Background(), timeout)
	defer cancel()
	cmd := exec.CommandContext(ctx, rec.Argv[0], rec.Argv[1:]...)
	cmd.Env = rec.Env
	cmd.WaitDelay = 2 * time.Second
	if err := cmd.Run(); err != nil {
		logTeardown(rec, err)
	}
}

func logTeardown(rec teardownRecord, err error) {
	_, _ = os.Stderr.WriteString("teardown " + strings.Join(rec.Argv[1:], " ") + ": " + err.Error() + "\n")
}
