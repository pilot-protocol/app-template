// cloudHandler routes one brokered method: it makes sure the caller is
// provisioned (auto-provision on first cloud use), then signs and forwards the
// call to the broker. The provision route itself just returns the result.
func cloudHandler(c *backend.CloudClient, verb, path string, isProvision bool, timeout time.Duration) ipc.Handler {
	return func(ctx context.Context, req *ipc.Envelope) (json.RawMessage, error) {
		ctx, cancel := context.WithTimeout(ctx, timeout)
		defer cancel()
		if isProvision {
			return c.EnsureProvisioned(ctx)
		}
		if _, err := c.EnsureProvisioned(ctx); err != nil {
			return nil, err
		}
		out, status, err := c.Call(ctx, verb, path, []byte(req.Payload))
		if err != nil {
			return nil, err
		}
		if status/100 != 2 {
			return nil, fmt.Errorf("%s %s: broker returned %d: %s", verb, path, status, string(out))
		}
		// A key/rotate response carries a (possibly rotated) key — keep the local
		// cache current so the stored key always matches the broker.
		c.RefreshKeyFromResponse(out)
		return out, nil
	}
}

// helpHandlerHybrid serves {{.Namespace}}.help and, on the side, best-effort
// provisions the caller so {{.Namespace}}.help establishes their cloud key per
// the app contract (provision on install or first help).
func helpHandlerHybrid(version, backendURL string, c *backend.CloudClient) ipc.Handler {
	base := helpHandler(version, backendURL)
	return func(ctx context.Context, env *ipc.Envelope) (json.RawMessage, error) {
		pctx, cancel := context.WithTimeout(ctx, 10*time.Second)
		defer cancel()
		_, _ = c.EnsureProvisioned(pctx)
		return base(ctx, env)
	}
}

// forwardExec runs the backend CLI for one local method: enumerated methods fill
// ${field} placeholders from the payload; passthrough methods take a verbatim
// "args" array. Both accept an optional "stdin" piped to the child.
func forwardExec(r *backend.Runner, spec backend.Spec, timeout time.Duration) ipc.Handler {
	return func(ctx context.Context, req *ipc.Envelope) (json.RawMessage, error) {
		call, err := decodeCall(spec, req.Payload)
		if err != nil {
			return nil, err
		}
		ctx, cancel := context.WithTimeout(ctx, timeout)
		defer cancel()
		return r.Run(ctx, spec, call)
	}
}

// decodeCall extracts one invocation's dynamic inputs from the IPC payload (see
// the cli backend for the full contract).
func decodeCall(spec backend.Spec, raw json.RawMessage) (backend.Call, error) {
	var call backend.Call
	if spec.Passthrough {
		var p struct {
			Args  []string `json:"args"`
			Stdin string   `json:"stdin"`
		}
		if len(raw) > 0 {
			if err := json.Unmarshal(raw, &p); err != nil {
				return call, fmt.Errorf(`passthrough payload must be {"args":[...],"stdin"?:"..."}: %w`, err)
			}
		}
		call.Args, call.Stdin = p.Args, p.Stdin
		return call, nil
	}
	params, err := stringParams(raw)
	if err != nil {
		return call, err
	}
	if s, ok := params["stdin"]; ok {
		call.Stdin = s
		delete(params, "stdin")
	}
	call.Params = params
	return call, nil
}
