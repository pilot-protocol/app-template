// splitPlanes groups methods into local vs cloud so <ns>.help reads clearly.
func splitPlanes(ms []methodDoc) (local, cloud []methodDoc) {
	for _, m := range ms {
		if m.Plane == "cloud" {
			cloud = append(cloud, m)
		} else {
			local = append(local, m)
		}
	}
	return local, cloud
}

{{if ne .Backend.Type "cli"}}func helpHandler(version, backendURL string) ipc.Handler {{"{"}}{{else}}func helpHandler(version string) ipc.Handler {{"{"}}{{end}}
