{{- if .Pricing}}
			"cloud": "brokered to the {{.Namespace}} cloud as you — may debit credit; your resources are isolated per user",
{{- else}}
			"cloud": "brokered to the {{.Namespace}} cloud as you; your resources are isolated per user",
{{- end}}
		},
