//go:build linux

// Process helpers for the CLI runner on Linux. GENERATED by pilot-app; see
// exec.go and calls.go.
package backend

import (
	"bytes"
	"os"
	"runtime"
	"strconv"
	"syscall"
)

// callSysProcAttr makes each call's child the leader of its own process group,
// so the call can be killed together with everything it started, and asks the
// kernel to SIGKILL the child if the adapter dies without cleaning up (a
// SIGKILL, or the supervisor's Pdeathsig when the daemon dies).
func callSysProcAttr() *syscall.SysProcAttr {
	return &syscall.SysProcAttr{Setpgid: true, Pdeathsig: syscall.SIGKILL}
}

// pinSpawnThread locks the calling goroutine to its OS thread until the returned
// func runs. Linux sends Pdeathsig when the thread that forked the child exits,
// not the process, and the Go runtime may retire an unlocked idle thread while
// the child is still running.
func pinSpawnThread() func() {
	runtime.LockOSThread()
	return runtime.UnlockOSThread
}

// groupMembers lists the live processes whose process group is pgid.
func groupMembers(pgid int) []int {
	ents, err := os.ReadDir("/proc")
	if err != nil {
		return nil
	}
	var out []int
	for _, e := range ents {
		pid, err := strconv.Atoi(e.Name())
		if err != nil {
			continue
		}
		b, err := os.ReadFile("/proc/" + e.Name() + "/stat")
		if err != nil {
			continue
		}
		// pid (comm) state ppid pgrp ...; comm may contain spaces and ')'.
		i := bytes.LastIndexByte(b, ')')
		if i < 0 {
			continue
		}
		f := bytes.Fields(b[i+1:])
		if len(f) < 3 || string(f[0]) == "Z" {
			continue
		}
		if g, err := strconv.Atoi(string(f[2])); err == nil && g == pgid {
			out = append(out, pid)
		}
	}
	return out
}

// procStartTime returns when pid started (field 22 of /proc/<pid>/stat, in
// clock ticks since boot), or "". A pid with the same start time is the same
// process: a recycled pid starts later.
func procStartTime(pid int) string {
	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
	if err != nil {
		return ""
	}
	i := bytes.LastIndexByte(b, ')')
	if i < 0 {
		return ""
	}
	f := bytes.Fields(b[i+1:])
	if len(f) < 20 {
		return ""
	}
	return string(f[19])
}

// procEnviron returns pid's environment, or nil if it cannot be read.
func procEnviron(pid int) []string {
	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/environ")
	if err != nil || len(b) == 0 {
		return nil
	}
	var env []string
	for _, kv := range bytes.Split(bytes.TrimRight(b, "\x00"), []byte{0}) {
		env = append(env, string(kv))
	}
	return env
}
