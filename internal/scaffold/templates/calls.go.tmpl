// Call process tracking for {{.ID}}. GENERATED by pilot-app; edit
// pilot.app.yaml and re-generate.
//
// Every CLI call runs in its own process group (exec.go). A call that is
// cancelled (its deadline passed, its caller hung up, or the adapter is
// stopping) has that whole group SIGKILLed, so nothing the CLI started, such as
// a shell escape or a helper process, outlives it. This file covers the cases
// the adapter cannot handle from inside its own process:
//
//   - The adapter is killed outright: the supervisor's stop is a SIGKILL, the
//     kernel kills it on Linux when the daemon dies, or the OOM killer picks
//     it. While calls are running, a guardian (this binary re-executed with
//     CallGuardianArg, in its own process group) holds the read end of a pipe
//     on which the adapter lists them. The kernel closes the pipe when the
//     adapter dies, however it dies. The guardian then kills every call group
//     still listed and exits. An adapter with nothing to guard for
//     guardianLinger lets its guardian exit, so an idle adapter runs no extra
//     process.
//   - The guardian was killed as well. Each call is also recorded as a file in
//     $APP/.calls, and ReapStaleCalls kills what those name on the next start.
//   - A call returned but left processes in its group (`cmd &`). The group
//     stays tracked and is killed when the adapter stops.
//
// Once a call's processes are gone, its process group id can be reused by an
// unrelated group, so a record alone never justifies a kill. A recorded group
// is killed only while one of its live members is provably the call's (see
// callID): it carries the call's unique PILOT_APP_CALL environment value,
// which everything the call starts inherits, or it is a process the adapter
// saw in the call's group, matched by pid and start time.
package backend

import (
	"bufio"
	"crypto/rand"
	"encoding/hex"
	"fmt"
	"io"
	"log"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"
	"sync"
	"syscall"
	"time"
)

// CallGuardianArg, as argv[1], makes this binary run as the call guardian
// (RunCallGuardian) instead of as the adapter.
const CallGuardianArg = "--pilot-call-guardian"

// callMarkerKey is the environment variable that carries a call's marker.
const callMarkerKey = "PILOT_APP_CALL"

const (
	// guardianWriteTimeout bounds one write to the guardian. A guardian that
	// stops reading (e.g. it was SIGSTOPped) is replaced, not waited on.
	guardianWriteTimeout = time.Second
	// guardianExitWait bounds how long a stopping adapter waits for its
	// guardian to exit.
	guardianExitWait = 2 * time.Second
	// guardianLinger is how long a guardian with nothing to guard is kept for
	// the next call before it is let go.
	guardianLinger = time.Second
)

// callID is what identifies a call's process group.
type callID struct {
	marker  string   // the PILOT_APP_CALL value the call's child was started with
	start   string   // the child's (the group leader's) start time
	members []string // "pid:start" of each process a returned call left behind
}

// owns reports whether process group pgid is still this call: one of its live
// members is the recorded leader or a recorded leftover (same pid and start
// time; a recycled pid starts later), or carries the call's marker.
func (id callID) owns(pgid int) bool {
	want := callMarkerKey + "=" + id.marker
	for _, pid := range groupMembers(pgid) {
		if st := procStartTime(pid); st != "" {
			if pid == pgid && st == id.start {
				return true
			}
			for _, m := range id.members {
				if m == strconv.Itoa(pid)+":"+st {
					return true
				}
			}
		}
		if id.marker != "" {
			for _, kv := range procEnviron(pid) {
				if kv == want {
					return true
				}
			}
		}
	}
	return false
}

// encode renders id as three space-separated fields, "-" for an empty one.
func (id callID) encode() string {
	dash := func(s string) string {
		if s == "" {
			return "-"
		}
		return s
	}
	return dash(id.marker) + " " + dash(id.start) + " " + dash(strings.Join(id.members, ","))
}

func decodeCallID(f []string) (callID, bool) {
	if len(f) != 3 {
		return callID{}, false
	}
	undash := func(s string) string {
		if s == "-" {
			return ""
		}
		return s
	}
	id := callID{marker: undash(f[0]), start: undash(f[1])}
	if m := undash(f[2]); m != "" {
		id.members = strings.Split(m, ",")
	}
	return id, true
}

// callRec is one tracked call's process group.
type callRec struct {
	id       callID
	returned bool // the call returned, but processes it started remain in its group
}

// callTracker records the process group of every call the adapter runs.
type callTracker struct {
	dir string // $APP/.calls

	mu        sync.Mutex
	recs      map[int]*callRec
	g         *guardianConn
	idle      *time.Timer // lets an idle guardian go (retireGuardian)
	guardFail bool        // the last guardian start failed; logged once
	closed    bool
}

func newCallTracker(appDir string) *callTracker {
	if appDir == "" {
		return nil
	}
	dir := filepath.Join(appDir, ".calls")
	if err := os.MkdirAll(dir, 0o700); err != nil {
		log.Printf("{{.BinaryName}}: call tracking off: %v", err)
		return nil
	}
	return &callTracker{dir: dir, recs: map[int]*callRec{}}
}

// newCallMarker returns a fresh random marker for one call.
func newCallMarker() string {
	var b [16]byte
	_, _ = rand.Read(b[:])
	return hex.EncodeToString(b[:])
}

func (t *callTracker) recPath(pgid int) string {
	return filepath.Join(t.dir, strconv.Itoa(pgid))
}

// begin records a started call: the process group its child leads, and the
// marker in the child's environment.
func (t *callTracker) begin(pgid int, marker string) {
	if t == nil {
		return
	}
	rec := &callRec{id: callID{marker: marker, start: procStartTime(pgid)}}
	t.mu.Lock()
	defer t.mu.Unlock()
	t.sweepLocked()
	t.recs[pgid] = rec
	t.saveLocked(pgid, rec)
}

// end runs once the call's child has exited and been reaped. If processes it
// started are still in its group, the group stays tracked, identified by
// those processes, until the adapter stops.
func (t *callTracker) end(pgid int) {
	if t == nil {
		return
	}
	var left []string
	if groupExists(pgid) {
		for _, pid := range groupMembers(pgid) {
			if st := procStartTime(pid); st != "" {
				left = append(left, strconv.Itoa(pid)+":"+st)
			}
		}
	}
	t.mu.Lock()
	defer t.mu.Unlock()
	rec := t.recs[pgid]
	if rec == nil {
		return
	}
	if len(left) > 0 || groupExists(pgid) {
		rec.returned = true
		rec.id.members = left
		t.saveLocked(pgid, rec)
		return
	}
	t.forgetLocked(pgid)
}

// saveLocked writes pgid's record file and tells the guardian.
func (t *callTracker) saveLocked(pgid int, rec *callRec) {
	line := strconv.Itoa(pgid) + " " + rec.id.encode()
	_ = os.WriteFile(t.recPath(pgid), []byte(line+"\n"), 0o600)
	t.notifyLocked("+" + line + "\n")
}

func (t *callTracker) forgetLocked(pgid int) {
	delete(t.recs, pgid)
	_ = os.Remove(t.recPath(pgid))
	if t.g != nil {
		t.notifyLocked(fmt.Sprintf("-%d\n", pgid))
	}
	if len(t.recs) == 0 && t.g != nil && t.idle == nil && !t.closed {
		t.idle = time.AfterFunc(guardianLinger, t.retireGuardian)
	}
}

// retireGuardian lets the guardian exit if there is still nothing to guard.
func (t *callTracker) retireGuardian() {
	t.mu.Lock()
	t.idle = nil
	g := t.g
	if len(t.recs) != 0 || g == nil {
		t.mu.Unlock()
		return
	}
	t.g = nil
	t.mu.Unlock()
	g.close() // an empty list: the guardian kills nothing and exits
}

// sweepLocked forgets returned calls whose process group has emptied since.
func (t *callTracker) sweepLocked() {
	for pgid, rec := range t.recs {
		if rec.returned && !groupExists(pgid) {
			t.forgetLocked(pgid)
		}
	}
}

// notifyLocked sends line to the guardian. If there is no live guardian, it
// starts one and sends it the whole list of tracked calls instead.
func (t *callTracker) notifyLocked(line string) {
	if t.closed {
		return
	}
	if t.idle != nil && len(t.recs) > 0 {
		t.idle.Stop()
		t.idle = nil
	}
	if t.g != nil {
		if t.g.send(line) == nil {
			return
		}
		t.g.abandon()
		t.g = nil
	}
	if len(t.recs) == 0 {
		return
	}
	g, err := startGuardian(t.dir)
	if err != nil {
		if !t.guardFail {
			log.Printf("{{.BinaryName}}: call guardian: %v (calls are still killed on stop, and on the next start if the adapter is killed)", err)
		}
		t.guardFail = true
		return
	}
	var b strings.Builder
	for pgid, rec := range t.recs {
		fmt.Fprintf(&b, "+%d %s\n", pgid, rec.id.encode())
	}
	if err := g.send(b.String()); err != nil {
		g.abandon()
		return
	}
	t.g, t.guardFail = g, false
}

// Close kills every process group still tracked (a call that outlived the
// shutdown drain, or what a returned call left behind), then lets the guardian
// exit. main calls it once serve has returned.
func (t *callTracker) Close() {
	if t == nil {
		return
	}
	t.mu.Lock()
	t.closed = true
	if t.idle != nil {
		t.idle.Stop()
		t.idle = nil
	}
	for pgid, rec := range t.recs {
		if killIfOurs(pgid, rec.id) {
			log.Printf("{{.BinaryName}}: killed call process group %d on shutdown", pgid)
		}
		delete(t.recs, pgid)
		_ = os.Remove(t.recPath(pgid))
	}
	g := t.g
	t.g = nil
	t.mu.Unlock()
	if g != nil {
		g.close()
	}
}

// guardianConn is the adapter's side of a running guardian.
type guardianConn struct {
	w    *os.File // write end of the guardian's stdin
	pid  int
	done chan struct{} // closed once the guardian has exited
}

// startGuardian re-executes this binary as the call guardian for dir.
func startGuardian(dir string) (*guardianConn, error) {
	self, err := os.Executable()
	if err != nil {
		return nil, err
	}
	// Both ends are close-on-exec: neither the guardian (beyond its stdin) nor
	// any CLI child inherits the write end, so the adapter's death is the only
	// thing that ends the guardian's input.
	pr, pw, err := os.Pipe()
	if err != nil {
		return nil, err
	}
	cmd := exec.Command(self, CallGuardianArg, dir)
	cmd.Stdin = pr
	cmd.Stderr = os.Stderr
	cmd.Env = []string{}
	// Its own process group: a signal to the adapter's group (the supervisor's
	// stop, or its stale-instance reaper) must not take the guardian with it.
	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
	err = cmd.Start()
	_ = pr.Close()
	if err != nil {
		_ = pw.Close()
		return nil, err
	}
	g := &guardianConn{w: pw, pid: cmd.Process.Pid, done: make(chan struct{})}
	go func() { _ = cmd.Wait(); close(g.done) }()
	return g, nil
}

func (g *guardianConn) send(s string) error {
	select {
	case <-g.done:
		return io.ErrClosedPipe
	default:
	}
	_ = g.w.SetWriteDeadline(time.Now().Add(guardianWriteTimeout))
	_, err := io.WriteString(g.w, s)
	return err
}

// abandon drops a guardian that stopped reading or died. It is killed before
// its input is closed: a live guardian that saw EOF would kill every running
// call.
func (g *guardianConn) abandon() {
	_ = syscall.Kill(g.pid, syscall.SIGKILL)
	_ = g.w.Close()
}

// close ends the guardian's input, so it exits (killing whatever is still
// listed, which after Close is nothing), and waits for it briefly.
func (g *guardianConn) close() {
	_ = g.w.Close()
	select {
	case <-g.done:
	case <-time.After(guardianExitWait):
	}
}

// RunCallGuardian is the guardian process. It reads the adapter's call list
// from stdin ("+<pgid> <callID>" when a call starts or its record changes,
// "-<pgid>" when it is over) until the adapter is gone (EOF), then kills every
// call group still listed and exits. args is [callsDir].
func RunCallGuardian(args []string) {
	calls := map[int]callID{}
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 64<<10), 1<<20)
	for sc.Scan() {
		line := sc.Text()
		if len(line) < 2 {
			continue
		}
		switch line[0] {
		case '+':
			if pgid, id, ok := parseCallLine(line[1:]); ok {
				calls[pgid] = id
			}
		case '-':
			if pgid, err := strconv.Atoi(strings.TrimSpace(line[1:])); err == nil {
				delete(calls, pgid)
			}
		}
	}
	for pgid, id := range calls {
		if killIfOurs(pgid, id) {
			log.Printf("{{.BinaryName}}: call guardian: adapter is gone; killed call process group %d", pgid)
		}
		if len(args) > 0 && args[0] != "" {
			_ = os.Remove(filepath.Join(args[0], strconv.Itoa(pgid)))
		}
	}
}

// ReapStaleCalls kills the call process groups that a previous instance of this
// adapter recorded in appDir/.calls and could not clean up (it and its
// guardian were both killed), then clears the records. It returns the groups
// it killed.
func ReapStaleCalls(appDir string) []int {
	if appDir == "" {
		return nil
	}
	dir := filepath.Join(appDir, ".calls")
	ents, err := os.ReadDir(dir)
	if err != nil {
		return nil
	}
	var reaped []int
	for _, e := range ents {
		p := filepath.Join(dir, e.Name())
		rec, _ := os.ReadFile(p)
		_ = os.Remove(p)
		pgid, id, ok := parseCallLine(strings.TrimSpace(string(rec)))
		if ok && strconv.Itoa(pgid) == e.Name() && killIfOurs(pgid, id) {
			reaped = append(reaped, pgid)
		}
	}
	return reaped
}

// parseCallLine parses "<pgid> <callID>", as written by saveLocked.
func parseCallLine(s string) (int, callID, bool) {
	f := strings.Fields(s)
	if len(f) != 4 {
		return 0, callID{}, false
	}
	pgid, err := strconv.Atoi(f[0])
	if err != nil {
		return 0, callID{}, false
	}
	id, ok := decodeCallID(f[1:])
	return pgid, id, ok
}

// killGroup SIGKILLs the process group a call's child leads (exec's Cancel for
// the call), falling back to the child alone.
func killGroup(pgid int) error {
	if err := syscall.Kill(-pgid, syscall.SIGKILL); err == nil {
		return nil
	}
	if err := syscall.Kill(pgid, syscall.SIGKILL); err != nil {
		if err == syscall.ESRCH {
			return os.ErrProcessDone
		}
		return err
	}
	return nil
}

// groupExists reports whether any process is still in process group pgid.
func groupExists(pgid int) bool {
	err := syscall.Kill(-pgid, 0)
	return err == nil || err == syscall.EPERM
}

// killIfOurs SIGKILLs process group pgid if it is still the call id names,
// not a later group that reused the id.
func killIfOurs(pgid int, id callID) bool {
	if pgid <= 1 || pgid == os.Getpid() || pgid == syscall.Getpgrp() || !groupExists(pgid) || !id.owns(pgid) {
		return false
	}
	return syscall.Kill(-pgid, syscall.SIGKILL) == nil
}
