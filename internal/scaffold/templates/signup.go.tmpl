// No-broker self-signup: mint a per-user backend API key and cache it locally.
//
// GENERATED by pilot-app for apps that declare a `signup:` method. Unlike the
// managed/provisioned models, NO Pilot broker is involved: the adapter drives
// the backend's own programmatic account-creation handshake, keyed by the USER's
// own email (backends suppress disposable mailboxes, so the code must land in a
// mailbox the user controls), and writes the returned key into $APP/secrets.json,
// from which the byo ${TOKEN} request headers resolve it on every later call.
//
// Two calls:
//   register — POST {email, password} → the backend emails the user a one-time
//              code. The account email + password are cached so the account is
//              recoverable and the verify step can default the email.
//   verify   — POST {email, code} → the key at keyPath is extracted and cached
//              under secretKey. After this, every method authenticates as you.
package main

import (
	"bytes"
	"context"
	"crypto/rand"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"math/big"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/pilot-protocol/app-store/pkg/ipc"
)

// signupRegisterConfig / signupVerifyConfig are baked in at generation time.
type signupRegisterConfig struct {
	url         string // POST {email,password} — starts registration (sends OTP)
	emailKey    string // secrets.json key for the account email
	passwordKey string // secrets.json key for the account password
}

type signupVerifyConfig struct {
	url       string // POST {email,code} — returns the credentials JSON
	keyPath   string // dotted path to the minted key in the response
	secretKey string // secrets.json key the minted key is stored under
	emailKey  string // secrets.json key the register step cached the email under
}

// signupRegisterHandler starts registration for the caller-supplied email.
func signupRegisterHandler(sc signupRegisterConfig, manifestPath string, timeout time.Duration) ipc.Handler {
	return func(ctx context.Context, req *ipc.Envelope) (json.RawMessage, error) {
		var in struct {
			Email    string `json:"email"`
			Password string `json:"password"`
		}
		if len(req.Payload) > 0 {
			_ = json.Unmarshal(req.Payload, &in)
		}
		in.Email = strings.TrimSpace(in.Email)
		if in.Email == "" {
			return nil, errors.New("signup: email is required — pass {\"email\":\"you@example.com\"} (the one-time code is sent there)")
		}
		if in.Password == "" {
			in.Password = signupPassword()
		}

		ctx, cancel := context.WithTimeout(ctx, timeout)
		defer cancel()

		status, raw, err := signupPost(ctx, sc.url, map[string]string{"email": in.Email, "password": in.Password})
		if err != nil {
			return nil, fmt.Errorf("signup: register: %w", err)
		}
		// An existing account (409, or a 400/422 whose body says "already
		// exists") is not a failure: the email is cached so verify can default it,
		// and the caller is told how to proceed (verify with a fresh code, or use
		// the account's existing key).
		if status == 409 || ((status == 400 || status == 422) && signupSaysExists(raw)) {
			if dir := signupAppDir(manifestPath); dir != "" && sc.emailKey != "" {
				_ = signupMergeSecrets(filepath.Join(dir, "secrets.json"), map[string]string{sc.emailKey: in.Email})
			}
			return signupResult(map[string]any{
				"ok": false, "exists": true, "email": in.Email,
				"message": "an account already exists for " + in.Email +
					" — if you have a pending code call the verify method, otherwise sign in at the provider or use a different email",
			})
		}
		if status != 200 && status != 201 {
			if status == 429 {
				return nil, errors.New("signup: registration rate-limited by the backend — wait and retry")
			}
			return nil, fmt.Errorf("signup: register HTTP %d: %s", status, signupSnippet(raw))
		}

		// Cache email + password so verify can default the email and the account
		// stays recoverable. Write-if-absent so a re-register doesn't clobber.
		if dir := signupAppDir(manifestPath); dir != "" {
			add := map[string]string{}
			if sc.emailKey != "" {
				add[sc.emailKey] = in.Email
			}
			if sc.passwordKey != "" {
				add[sc.passwordKey] = in.Password
			}
			_ = signupMergeSecrets(filepath.Join(dir, "secrets.json"), add)
		}

		return signupResult(map[string]any{
			"ok":      true,
			"email":   in.Email,
			"next":    "check that inbox for the one-time code, then call the verify method with {code}",
			"message": "registration started; a one-time code was emailed to " + in.Email,
		})
	}
}

// signupVerifyHandler redeems the OTP and caches the minted key.
func signupVerifyHandler(sc signupVerifyConfig, manifestPath string, timeout time.Duration) ipc.Handler {
	return func(ctx context.Context, req *ipc.Envelope) (json.RawMessage, error) {
		dir := signupAppDir(manifestPath)
		if dir == "" {
			return nil, errors.New("signup: cannot locate the app directory to cache the key")
		}
		secretsFile := filepath.Join(dir, "secrets.json")
		cached := signupReadSecrets(secretsFile)

		// Idempotent: already have a key.
		if cached[sc.secretKey] != "" {
			return signupResult(map[string]any{
				"ok": true, "already": true, "email": cached[sc.emailKey],
				"key_field": sc.secretKey,
				"message":   "already verified; the cached key is used on every call",
			})
		}

		var in struct {
			Email string `json:"email"`
			Code  string `json:"code"`
		}
		if len(req.Payload) > 0 {
			_ = json.Unmarshal(req.Payload, &in)
		}
		in.Email = strings.TrimSpace(in.Email)
		if in.Email == "" {
			in.Email = cached[sc.emailKey] // default to the email register cached
		}
		in.Code = strings.TrimSpace(in.Code)
		if in.Email == "" || in.Code == "" {
			return nil, errors.New("signup: email and code are required — pass {\"email\":\"...\",\"code\":\"ABC123\"} (the code from the registration email)")
		}

		ctx, cancel := context.WithTimeout(ctx, timeout)
		defer cancel()

		status, raw, err := signupPost(ctx, sc.url, map[string]string{"email": in.Email, "code": in.Code})
		if err != nil {
			return nil, fmt.Errorf("signup: verify: %w", err)
		}
		if status != 200 && status != 201 {
			return nil, fmt.Errorf("signup: verify HTTP %d: %s", status, signupSnippet(raw))
		}
		key := signupDigString(raw, sc.keyPath)
		if key == "" {
			return nil, fmt.Errorf("signup: verify response had no key at %q", sc.keyPath)
		}
		if err := signupMergeSecrets(secretsFile, map[string]string{sc.secretKey: key}); err != nil {
			return nil, fmt.Errorf("signup: cache key: %w", err)
		}

		return signupResult(map[string]any{
			"ok": true, "email": in.Email, "key_field": sc.secretKey, "api_key": "saved",
			"message": "verified; key cached to secrets.json and used on every subsequent call",
		})
	}
}

// accountConfig / accountHandler expose the cached account for retrieval: the
// minted email + key are persistent in $APP/secrets.json, and this returns them
// (the user owns their own key) plus a signed_up flag. Local, no backend call.
type accountConfig struct {
	secretKey string
	emailKey  string
	urlKey    string // secrets.json key holding a per-user backend URL (empty = none)
}

func accountHandler(ac accountConfig, manifestPath string) ipc.Handler {
	return func(ctx context.Context, req *ipc.Envelope) (json.RawMessage, error) {
		m := map[string]string{}
		if dir := signupAppDir(manifestPath); dir != "" {
			m = signupReadSecrets(filepath.Join(dir, "secrets.json"))
		}
		out := map[string]any{
			"signed_up": m[ac.secretKey] != "",
			"email":     m[ac.emailKey],
			"api_key":   m[ac.secretKey],
		}
		if ac.urlKey != "" {
			out["backend_url"] = m[ac.urlKey]
		}
		return signupResult(out)
	}
}

// ── shared helpers ──────────────────────────────────────────────────────────

func signupResult(m map[string]any) (json.RawMessage, error) {
	b, err := json.Marshal(m)
	if err != nil {
		return nil, err
	}
	return json.RawMessage(b), nil
}

// signupAppDir resolves the app directory (the manifest's dir, or $APP).
func signupAppDir(manifestPath string) string {
	if manifestPath != "" {
		return filepath.Dir(manifestPath)
	}
	return os.Getenv("APP")
}

func signupReadSecrets(path string) map[string]string {
	out := map[string]string{}
	if b, err := os.ReadFile(path); err == nil {
		_ = json.Unmarshal(b, &out)
	}
	return out
}

// signupMergeSecrets merges add into path (0600), write-if-absent so a
// concurrent spawn that already wrote a value wins.
func signupMergeSecrets(path string, add map[string]string) error {
	if len(add) == 0 {
		return nil
	}
	m := signupReadSecrets(path)
	for k, v := range add {
		if v == "" {
			continue
		}
		if _, ok := m[k]; !ok {
			m[k] = v
		}
	}
	out, err := json.MarshalIndent(m, "", "  ")
	if err != nil {
		return err
	}
	if d := filepath.Dir(path); d != "" {
		_ = os.MkdirAll(d, 0o755)
	}
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, append(out, '\n'), 0o600); err != nil {
		return err
	}
	return os.Rename(tmp, path)
}

var signupHTTP = &http.Client{Timeout: 30 * time.Second}

// signupPost does one JSON POST and returns (status, body, transport-error).
func signupPost(ctx context.Context, url string, body map[string]string) (int, json.RawMessage, error) {
	b, err := json.Marshal(body)
	if err != nil {
		return 0, nil, err
	}
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(b))
	if err != nil {
		return 0, nil, err
	}
	req.Header.Set("Accept", "application/json")
	req.Header.Set("Content-Type", "application/json")
	resp, err := signupHTTP.Do(req)
	if err != nil {
		return 0, nil, err
	}
	defer resp.Body.Close()
	raw, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	return resp.StatusCode, json.RawMessage(raw), nil
}

// signupDigString walks a dotted path through a JSON object to a string leaf.
func signupDigString(raw json.RawMessage, path string) string {
	cur := raw
	for _, part := range strings.Split(path, ".") {
		var obj map[string]json.RawMessage
		if json.Unmarshal(cur, &obj) != nil {
			return ""
		}
		next, ok := obj[part]
		if !ok {
			return ""
		}
		cur = next
	}
	var s string
	if json.Unmarshal(cur, &s) == nil {
		return s
	}
	return ""
}

// signupSaysExists reports whether a response body indicates the account
// already exists (backends signal this with varied wording + status codes).
func signupSaysExists(raw json.RawMessage) bool {
	s := strings.ToLower(string(raw))
	return strings.Contains(s, "already exist") ||
		strings.Contains(s, "already registered") || strings.Contains(s, "already in use")
}

func signupSnippet(raw json.RawMessage) string {
	s := strings.TrimSpace(string(raw))
	if len(s) > 300 {
		s = s[:300]
	}
	return s
}

const signupLowerAlphabet = "abcdefghijklmnopqrstuvwxyz0123456789"

// signupPassword builds a password satisfying common complexity rules
// (>=8 chars, upper+lower+digit+special).
func signupPassword() string {
	b := make([]byte, 14)
	for i := range b {
		b[i] = signupLowerAlphabet[signupRandInt(len(signupLowerAlphabet))]
	}
	return string(b) + "Aa1!"
}

func signupRandInt(n int) int {
	if n <= 0 {
		return 0
	}
	v, err := rand.Int(rand.Reader, big.NewInt(int64(n)))
	if err != nil {
		return 0
	}
	return int(v.Int64())
}
