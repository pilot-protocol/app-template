import "syscall"

// serviceSysProcAttr: a server started by a cli.service method gets SIGTERM —
// a clean shutdown, not SIGKILL — when the adapter thread that started it dies,
// including when the adapter is SIGKILLed or killed by its own Pdeathsig. It
// stays in the adapter's process group so a supervisor group stop and the
// child guard (childguard.go) also reach it.
func serviceSysProcAttr() *syscall.SysProcAttr {
	return &syscall.SysProcAttr{Pdeathsig: syscall.SIGTERM}
}
