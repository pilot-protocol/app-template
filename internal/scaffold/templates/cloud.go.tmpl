// Cloud data-plane client for the {{.ID}} adapter's brokered methods. Local
// methods run the CLI (see exec.go); cloud methods are signed with the daemon
// identity and sent to the Pilot broker, which holds the master key, mints this
// user's per-user key, meters credit, and forwards to the cloud. The adapter
// never holds the master key. GENERATED by pilot-app; edit pilot.app.yaml and
// re-generate.
package backend

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"time"
)

// provisionPath is the broker's reserved auto-provision route.
const provisionPath = "{{.ProvisionPath}}"

// cloudKeyName is the secrets.json key the provisioned per-user key is cached
// under — readable only by this user's app ($APP/secrets.json, 0600).
const cloudKeyName = "{{.Namespace}}_cloud_key"

// CloudClient signs and sends brokered (cloud) requests for this app.
type CloudClient struct {
	base   string
	sign   Signer
	appDir string
	http   *http.Client

	once    sync.Once
	prov    json.RawMessage
	provErr error
}

// NewCloudClient builds the cloud client. base is the broker URL for this app
// (…/<app-id>); identityPath is the daemon --identity; appDir is $APP, where the
// provisioned key is cached.
func NewCloudClient(base, identityPath, appDir string) (*CloudClient, error) {
	signer, err := NewSigner(identityPath)
	if err != nil {
		return nil, err
	}
	return &CloudClient{
		base:   strings.TrimRight(base, "/"),
		sign:   signer,
		appDir: appDir,
		http:   &http.Client{Timeout: 300 * time.Second},
	}, nil
}

// Call signs (method, full-path, body) and sends one brokered request, returning
// the raw response body + status. The signed path includes the /<app-id> prefix
// already baked into base, matching exactly what the broker verifies server-side.
func (c *CloudClient) Call(ctx context.Context, verb, path string, body []byte) (json.RawMessage, int, error) {
	req, err := http.NewRequestWithContext(ctx, verb, c.base+path, bytes.NewReader(body))
	if err != nil {
		return nil, 0, err
	}
	req.Header.Set("Content-Type", "application/json")
	for k, v := range c.sign(verb, req.URL.Path, body) {
		req.Header.Set(k, v)
	}
	resp, err := c.http.Do(req)
	if err != nil {
		return nil, 0, err
	}
	defer resp.Body.Close()
	rb, _ := io.ReadAll(resp.Body)
	return json.RawMessage(rb), resp.StatusCode, nil
}

// EnsureProvisioned makes sure this user has a provisioned cloud key. Idempotent:
// it returns the cached key when present, otherwise asks the broker (which
// records identity + source IP and seeds the credit ledger) and caches the key
// write-if-absent so concurrent adapter spawns don't clobber. The derived key is
// deterministic per user, so a cache race is benign (both writers agree).
func (c *CloudClient) EnsureProvisioned(ctx context.Context) (json.RawMessage, error) {
	c.once.Do(func() { c.prov, c.provErr = c.ensure(ctx) })
	return c.prov, c.provErr
}

func (c *CloudClient) ensure(ctx context.Context) (json.RawMessage, error) {
	if key := c.cachedKey(); key != "" {
		return json.RawMessage(fmt.Sprintf(`{"key":%q,"provisioned":true}`, key)), nil
	}
	body, status, err := c.Call(ctx, "POST", provisionPath, nil)
	if err != nil {
		return nil, err
	}
	if status/100 != 2 {
		return nil, fmt.Errorf("provision failed (%d): %s", status, strings.TrimSpace(string(body)))
	}
	var parsed struct {
		Key string `json:"key"`
	}
	if json.Unmarshal(body, &parsed) == nil && parsed.Key != "" {
		_ = c.cacheKey(parsed.Key) // best-effort; the key still works this run if the write fails
	}
	return body, nil
}

func (c *CloudClient) secretsPath() string {
	if c.appDir == "" {
		return ""
	}
	return filepath.Join(c.appDir, "secrets.json")
}

func (c *CloudClient) cachedKey() string {
	p := c.secretsPath()
	if p == "" {
		return ""
	}
	b, err := os.ReadFile(p)
	if err != nil {
		return ""
	}
	var m map[string]string
	if json.Unmarshal(b, &m) != nil {
		return ""
	}
	return m[cloudKeyName]
}

// cacheKey merges the provisioned key into $APP/secrets.json (0600),
// write-if-absent: if another spawn already wrote it, keep theirs.
func (c *CloudClient) cacheKey(key string) error {
	p := c.secretsPath()
	if p == "" {
		return fmt.Errorf("no app dir to cache the cloud key")
	}
	m := map[string]string{}
	if b, err := os.ReadFile(p); err == nil {
		_ = json.Unmarshal(b, &m)
	}
	if _, ok := m[cloudKeyName]; ok {
		return nil
	}
	m[cloudKeyName] = key
	out, err := json.MarshalIndent(m, "", "  ")
	if err != nil {
		return err
	}
	tmp := p + ".tmp"
	if err := os.WriteFile(tmp, append(out, '\n'), 0o600); err != nil {
		return err
	}
	return os.Rename(tmp, p)
}
