//go:build darwin

// Process helpers for the CLI runner on macOS. GENERATED by pilot-app; see
// exec.go and calls.go.
package backend

import (
	"bytes"
	"encoding/binary"
	"strconv"
	"syscall"

	"golang.org/x/sys/unix"
)

// callSysProcAttr makes each call's child the leader of its own process group,
// so the call can be killed together with everything it started. macOS has no
// parent-death signal: the call guardian (calls.go) kills the group if the
// adapter dies without cleaning up.
func callSysProcAttr() *syscall.SysProcAttr {
	return &syscall.SysProcAttr{Setpgid: true}
}

func pinSpawnThread() func() { return func() {} }

// szomb is p_stat for a zombie (sys/proc.h).
const szomb = 5

// groupMembers lists the live processes whose process group is pgid.
func groupMembers(pgid int) []int {
	kps, err := unix.SysctlKinfoProcSlice("kern.proc.pgrp", pgid)
	if err != nil {
		return nil
	}
	var out []int
	for _, kp := range kps {
		if int(kp.Eproc.Pgid) == pgid && kp.Proc.P_stat != szomb {
			out = append(out, int(kp.Proc.P_pid))
		}
	}
	return out
}

// procStartTime returns when pid started, or "". A pid with the same start
// time is the same process: a recycled pid starts later.
func procStartTime(pid int) string {
	kp, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
	if err != nil || kp == nil || int(kp.Proc.P_pid) != pid {
		return ""
	}
	st := kp.Proc.P_starttime
	return strconv.FormatInt(int64(st.Sec), 10) + "." + strconv.FormatInt(int64(st.Usec), 10)
}

// procEnviron returns pid's environment, or nil if it cannot be read. macOS
// withholds the environment of some processes (platform binaries such as
// /bin/sh), so a call's marker is not always visible here; callID.owns also
// matches on process start times. kern.procargs2 is: int32 argc, the exec
// path, NUL padding, argc argv strings, then the environment strings, ended
// by an empty string.
func procEnviron(pid int) []string {
	raw, err := unix.SysctlRaw("kern.procargs2", pid)
	if err != nil || len(raw) < 4 {
		return nil
	}
	argc := int(binary.LittleEndian.Uint32(raw[:4]))
	b := raw[4:]
	i := bytes.IndexByte(b, 0)
	if i < 0 {
		return nil
	}
	b = b[i:]
	for len(b) > 0 && b[0] == 0 {
		b = b[1:]
	}
	for n := 0; n < argc; n++ {
		i := bytes.IndexByte(b, 0)
		if i < 0 {
			return nil
		}
		b = b[i+1:]
	}
	var env []string
	for len(b) > 0 {
		i := bytes.IndexByte(b, 0)
		if i <= 0 {
			break
		}
		env = append(env, string(b[:i]))
		b = b[i+1:]
	}
	return env
}
