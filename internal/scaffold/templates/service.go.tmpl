// Managed servers for the {{.ID}} cli runner. GENERATED by pilot-app; edit
// pilot.app.yaml and re-generate.
//
// A cli.service method starts a long-running server that the adapter owns, and
// nothing it starts may outlive the adapter. A server that forks itself into
// the background (redis-server --daemonize yes, pg_ctl start, mysqld
// --daemonize) calls setsid(): it leaves the adapter's process group and is
// reparented to init, out of reach of the adapter, of Pdeathsig, of the
// supervisor's group stop and of the child guard. Found with io.pilot.redis
// 8.6.2: redis.start ran `redis-server --daemonize yes` and the server
// survived the adapter's SIGTERM, the supervisor's SIGKILL of the adapter and
// the supervisor's own death, on Linux and macOS.
//
// So a service runs as the adapter's own foreground child, in its process
// group, with cli.service.force_args appended last (e.g. --daemonize no, which
// wins over anything the caller or a config file set). The call returns once
// the server is ready. Then:
//   - a clean stop (SIGTERM, or the parent-death watch in main) runs
//     StopServices: SIGTERM, then SIGKILL after serviceStopGrace;
//   - while a service runs it holds the child guard (childguard.go), so an
//     adapter that is SIGKILLed takes the server down with it on every OS;
//   - on Linux the server also gets SIGTERM from the kernel when the adapter
//     dies (Pdeathsig, svcproc_linux.go).
// The passthrough tools allowlist (checkTool in exec.go) is what stops a
// caller from naming the server by another path, or a shell, to start it
// daemonized anyway.
package backend

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"log"
	"net"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"sync"
	"syscall"
	"time"
)

const (
	// serviceStopGrace: SIGTERM → SIGKILL for a service being stopped.
	serviceStopGrace = 8 * time.Second
	// serviceTailBytes of a service's stdout+stderr are kept for error replies.
	serviceTailBytes = 16 << 10
	// logTailBytes of a service's own log file are returned when it fails.
	logTailBytes = 4 << 10
)

// ServiceSpec is a method's cli.service block, baked in at generation time.
type ServiceSpec struct {
	ReadyTCP     string        // host:port (${field}) that accepts once ready; "" = use ReadyAfter
	ReadyAfter   time.Duration // no ReadyTCP: ready once the process has stayed up this long
	ReadyTimeout time.Duration // stop it and fail the call if not ready by then
	LogFile      string        // the server's own log (${field}); its tail is returned on failure
	ForceArgs    []string      // appended after every other argument (last-wins flags)
	Tools        []string      // passthrough: the args[0] names that start a server
}

// appliesTo reports whether this call starts a server. Every call of an
// enumerated method does; a passthrough call does when its tool is one of
// Tools (compared by base name, so a path spelling cannot dodge it).
func (s *ServiceSpec) appliesTo(spec Spec, call Call) bool {
	if !spec.Passthrough {
		return true
	}
	if len(call.Args) == 0 {
		return false
	}
	tool := filepath.Base(call.Args[0])
	for _, t := range s.Tools {
		if tool == t {
			return true
		}
	}
	return false
}

type service struct {
	name string
	cmd  *exec.Cmd
	out  *tailBuffer
	done chan struct{} // closed once Wait has returned
	err  error         // Wait's result, valid after done
}

var (
	svcMu     sync.Mutex
	services  = map[*service]struct{}{}
	svcClosed bool // set by StopServices: no new service may start
)

// startService runs one service call: start the server, wait until it is
// ready (or exits, or times out), and leave it running under the adapter.
func (r *Runner) startService(ctx context.Context, sv *ServiceSpec, args []string, call Call) (json.RawMessage, error) {
	var readyAddr, logFile string
	if sv.ReadyTCP != "" {
		a, err := substitute(sv.ReadyTCP, call.Params)
		if err != nil {
			return nil, err
		}
		readyAddr = a
		// Something already answering there would make the readiness probe
		// report success for a server that is about to fail to bind.
		if dialOK(readyAddr, 300*time.Millisecond) {
			return nil, fmt.Errorf("backend: %s is already accepting connections — a server is already running there; stop it or use another port", readyAddr)
		}
	}
	if sv.LogFile != "" {
		if lf, err := substitute(sv.LogFile, call.Params); err == nil {
			logFile = lf
		}
	}
	argv := append(append([]string(nil), args...), sv.ForceArgs...)
	name := filepath.Base(r.base[0])
	if len(argv) > 0 {
		name = filepath.Base(argv[0])
	}

	s := &service{name: name, out: &tailBuffer{limit: serviceTailBytes}, done: make(chan struct{})}
	cmd := exec.Command(r.base[0], argv...)
	cmd.Env = r.childEnv()
	cmd.Stdout, cmd.Stderr = s.out, s.out
	cmd.WaitDelay = 2 * time.Second // don't wait forever on pipes a grandchild inherited
	cmd.SysProcAttr = serviceSysProcAttr()
	s.cmd = cmd

	started := make(chan error, 1)
	go func() {
		// Pdeathsig (Linux) fires when the thread that forked the server
		// exits, so that thread stays pinned for the server's whole life.
		unlock := lockForChild()
		defer unlock()
		svcMu.Lock()
		if svcClosed {
			svcMu.Unlock()
			started <- errors.New("adapter is shutting down")
			return
		}
		// The guard is held for as long as the server runs: if the adapter is
		// SIGKILLed, it takes the adapter's process group down, server included.
		guard.acquire()
		err := cmd.Start()
		if err == nil {
			services[s] = struct{}{}
		} else {
			guard.release()
		}
		svcMu.Unlock()
		started <- err
		if err != nil {
			return
		}
		s.err = cmd.Wait()
		svcMu.Lock()
		delete(services, s)
		svcMu.Unlock()
		// Released before done is closed, so a shutdown that waited for done
		// finds the guard idle and can retire it (CloseChildGuard).
		guard.release()
		close(s.done)
	}()
	if err := <-started; err != nil {
		return nil, fmt.Errorf("backend: start %s: %w", name, err)
	}

	t0 := time.Now()
	deadline := time.NewTimer(sv.ReadyTimeout)
	defer deadline.Stop()
	tick := time.NewTicker(50 * time.Millisecond)
	defer tick.Stop()
	for {
		select {
		case <-s.done:
			// Exited before it was ready: a one-shot invocation (--help,
			// --version) or a failed start. Either way, a plain CLI result.
			return exitedResult(s, logFile)
		case <-ctx.Done():
			s.stop(serviceStopGrace)
			return nil, fmt.Errorf("backend: %s: %w before it was ready; stopped it%s", name, ctx.Err(), failureDetail(s, logFile))
		case <-deadline.C:
			s.stop(serviceStopGrace)
			return nil, fmt.Errorf("backend: %s was not ready within %s; stopped it%s", name, sv.ReadyTimeout, failureDetail(s, logFile))
		case <-tick.C:
			if readyAddr != "" {
				if !dialOK(readyAddr, 250*time.Millisecond) {
					continue
				}
			} else if time.Since(t0) < sv.ReadyAfter {
				continue
			}
			select {
			case <-s.done:
				return exitedResult(s, logFile)
			default:
			}
			msg := fmt.Sprintf("%s started (pid %d)", name, cmd.Process.Pid)
			if readyAddr != "" {
				msg += ", accepting connections on " + readyAddr
			}
			msg += "; it runs under this app and stops when the app stops"
			out, _ := json.Marshal(map[string]any{
				"stdout":    msg,
				"stderr":    "",
				"exit":      0,
				"truncated": false,
				"pid":       cmd.Process.Pid,
			})
			return out, nil
		}
	}
}

// stop SIGTERMs the service, then SIGKILLs it after grace, and waits for it.
func (s *service) stop(grace time.Duration) {
	_ = s.cmd.Process.Signal(syscall.SIGTERM)
	select {
	case <-s.done:
		return
	case <-time.After(grace):
	}
	_ = s.cmd.Process.Kill()
	select {
	case <-s.done:
	case <-time.After(2 * time.Second):
	}
}

// StopServices stops every running service (SIGTERM, SIGKILL after
// serviceStopGrace) and refuses new ones. Call it on shutdown, after the serve
// loop returns.
func StopServices() {
	svcMu.Lock()
	svcClosed = true
	list := make([]*service, 0, len(services))
	for s := range services {
		list = append(list, s)
	}
	svcMu.Unlock()
	if len(list) == 0 {
		return
	}
	for _, s := range list {
		_ = s.cmd.Process.Signal(syscall.SIGTERM)
	}
	deadline := time.After(serviceStopGrace)
wait:
	for _, s := range list {
		select {
		case <-s.done:
		case <-deadline:
			break wait
		}
	}
	for _, s := range list {
		select {
		case <-s.done:
		default:
			log.Printf("backend: service %s (pid %d) ignored SIGTERM for %s; killing it", s.name, s.cmd.Process.Pid, serviceStopGrace)
			_ = s.cmd.Process.Kill()
			select {
			case <-s.done:
			case <-time.After(2 * time.Second):
			}
		}
	}
}

func exitedResult(s *service, logFile string) (json.RawMessage, error) {
	code := 0
	if s.err != nil {
		var ee *exec.ExitError
		if !errors.As(s.err, &ee) {
			return nil, fmt.Errorf("backend: %s: %w: %s", s.name, s.err, strings.TrimSpace(s.out.String()))
		}
		code = ee.ExitCode()
	}
	res := map[string]any{
		"stdout":    strings.TrimSpace(s.out.String()),
		"stderr":    "",
		"exit":      code,
		"truncated": s.out.dropped(),
	}
	if code != 0 && logFile != "" {
		if t := fileTail(logFile, logTailBytes); t != "" {
			res["stderr"] = t
		}
	}
	out, _ := json.Marshal(res)
	return out, nil
}

func failureDetail(s *service, logFile string) string {
	var parts []string
	if o := strings.TrimSpace(s.out.String()); o != "" {
		parts = append(parts, "output: "+o)
	}
	if logFile != "" {
		if t := fileTail(logFile, logTailBytes); t != "" {
			parts = append(parts, "log "+logFile+": "+t)
		}
	}
	if len(parts) == 0 {
		return ""
	}
	return " — " + strings.Join(parts, "; ")
}

func fileTail(path string, n int64) string {
	f, err := os.Open(path)
	if err != nil {
		return ""
	}
	defer f.Close()
	if st, err := f.Stat(); err == nil && st.Size() > n {
		_, _ = f.Seek(st.Size()-n, io.SeekStart)
	}
	b, _ := io.ReadAll(io.LimitReader(f, n))
	return strings.TrimSpace(string(b))
}

func dialOK(addr string, timeout time.Duration) bool {
	c, err := net.DialTimeout("tcp", addr, timeout)
	if err != nil {
		return false
	}
	_ = c.Close()
	return true
}

// tailBuffer keeps the last limit bytes written to it; it never blocks the
// writer, so a chatty server cannot stall on a full pipe or grow memory.
type tailBuffer struct {
	mu    sync.Mutex
	buf   []byte
	limit int
	cut   bool
}

func (t *tailBuffer) Write(p []byte) (int, error) {
	t.mu.Lock()
	defer t.mu.Unlock()
	t.buf = append(t.buf, p...)
	if over := len(t.buf) - t.limit; over > 0 {
		t.buf = append(t.buf[:0], t.buf[over:]...)
		t.cut = true
	}
	return len(p), nil
}

func (t *tailBuffer) String() string {
	t.mu.Lock()
	defer t.mu.Unlock()
	return string(t.buf)
}

func (t *tailBuffer) dropped() bool {
	t.mu.Lock()
	defer t.mu.Unlock()
	return t.cut
}
