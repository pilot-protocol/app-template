{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilotprotocol.network/schema/appstore-meta/index.schema.json",
  "title": "Pilot app-store presentation index",
  "description": "The shelves the store renders and the order of the hero carousel.",
  "type": "object",
  "required": [
    "schema_version",
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "description": "Where this data is maintained."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "blurb": {
            "type": "string"
          },
          "hue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 360
          }
        }
      }
    },
    "featured_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Carousel order. Every id must have an app file, and that app must be marked featured."
    },
    "app_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The curated order the store renders apps in, so both surfaces show a shelf the same way. Every id must have an app file; apps it does not name follow, sorted by id."
    }
  }
}
